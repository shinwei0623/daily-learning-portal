---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import LevelToggle from '../components/LevelToggle.astro';
import VocabCard from '../components/VocabCard.astro';
import { formatZhDate, taipeiDateISO } from '../lib/dates';
import { LEVELS, type LevelId, SITE_NAME } from '../lib/site';

const today = taipeiDateISO();
const englishAll = await getCollection('english');
const yilanAll = (await getCollection('yilan')).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestYilan = yilanAll[0];
const dates = [...new Set(englishAll.map((e) => e.data.date))].sort().reverse();
const latestEnglishDate = dates[0];
const showDate = dates.includes(today) ? today : latestEnglishDate;

const requested = Astro.url.searchParams.get('level');
const homeLevel: LevelId = requested === 'senior' ? 'senior' : 'junior';
const stories = englishAll
  .filter((e) => e.data.date === showDate && e.data.level === homeLevel)
  .sort((a, b) => a.data.slot - b.data.slot);

const rendered = [];
for (const entry of stories) {
  const { Content } = await render(entry);
  rendered.push({ entry, Content });
}

const yilanRendered = latestYilan ? await render(latestYilan) : null;
const YilanBody = yilanRendered?.Content;

const base = import.meta.env.BASE_URL;
---
<BaseLayout title="今日" description={`${SITE_NAME}：今天的英語短文與宜蘭見聞。`}>
  <div class="wrap hero">
    <p class="kicker">公益學習 · 每日更新</p>
    <h1>今天，讀兩則短文，認識宜蘭一事</h1>
    <p class="lede">英語單字可切換國中或高中程度；宜蘭見聞附來源與授權圖片，並可一鍵列印成 A4 張貼。</p>
  </div>

  <div class="wrap grid-2" style="margin-bottom: 2rem;">
    <section class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:0.8rem;flex-wrap:wrap;">
        <h2>英語單字</h2>
        <LevelToggle current={homeLevel} />
      </div>
      <p class="meta">{showDate ? formatZhDate(showDate) : ''} · {LEVELS[homeLevel].label} · {LEVELS[homeLevel].words}</p>
      {rendered.length === 0 && <p>尚無這個程度的短文。</p>}
      {rendered.map(({ entry, Content }) => (
        <article style="margin-bottom: 1.4rem;">
          <h3 style="margin:0 0 0.3rem;">{entry.data.title_zh} <span style="font-weight:500;color:var(--ink-soft);font-family:var(--font-en);font-size:0.95rem;">{entry.data.title}</span></h3>
          <div class="story"><Content /></div>
          <div class="vocab-grid">
            {entry.data.words.map((w) => <VocabCard item={w} />)}
          </div>
        </article>
      ))}
      <div class="btn-row">
        <a class="btn btn-primary btn-link" href={`${base}english/${homeLevel}/`}>看英語檔案</a>
      </div>
    </section>

    <section class="card">
      <h2>宜蘭每日見聞</h2>
      {latestYilan ? (
        <>
          <p class="meta">{formatZhDate(latestYilan.data.date)}</p>
          <h3 style="margin-top:0;">{latestYilan.data.title}</h3>
          <figure class="article-image">
            <img src={`${base}${latestYilan.data.image}`} alt={latestYilan.data.image_alt} width="900" height="580" />
          </figure>
          <p class="credit">{latestYilan.data.image_credit}</p>
          <div class="yilan-body">{YilanBody && <YilanBody />}</div>
          <div class="btn-row">
            <a class="btn btn-primary btn-link" href={`${base}yilan/${latestYilan.data.date}/`}>閱讀並列印 A4</a>
          </div>
        </>
      ) : (
        <p>尚無見聞。</p>
      )}
    </section>
  </div>
</BaseLayout>
<script is:inline src={`${import.meta.env.BASE_URL}scripts/level-pref.js`}></script>
<script is:inline>
  (function () {
    var params = new URLSearchParams(location.search);
    if (params.has('level')) return;
    var pref = localStorage.getItem('riri-level');
    if (pref === 'senior' || pref === 'junior') {
      params.set('level', pref);
      history.replaceState(null, '', location.pathname + '?' + params.toString() + location.hash);
      // 不強制重載：若與預設不同再跳轉一次
      if (pref === 'senior') location.replace(location.pathname + '?level=senior' + location.hash);
    }
  })();
</script>
