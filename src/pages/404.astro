---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="找不到這一頁">
  <div class="wrap hero">
    <h1>找不到這一頁</h1>
    <p class="lede">也許網址打錯了，或這一天的內容還沒發布。</p>
    <p><a class="btn btn-primary btn-link" href={base}>回到今日</a></p>
  </div>
</BaseLayout>
