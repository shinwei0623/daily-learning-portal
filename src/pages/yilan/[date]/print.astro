---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatZhDate, countChineseChars } from '../../../lib/dates';

export async function getStaticPaths() {
  const all = await getCollection('yilan');
  return all.map((entry) => ({ params: { date: entry.data.date }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const data = entry.data;
const chars = countChineseChars(entry.body ?? '');
---
<BaseLayout title={`${data.title}（A4 列印版）`} description={`${formatZhDate(data.date)} 列印版`} printFriendly>
  <article class="wrap" style="padding:0;max-width:100%;">
    <p class="no-print print-bar">
      <button class="btn btn-primary" type="button" onclick="window.print()">列印 A4</button>
      <a class="btn btn-ghost btn-link" href={`${base}pdfs/yilan-${data.date}.pdf`} download>下載 PDF</a>
      <a class="btn btn-ghost btn-link" href={`${base}yilan/${data.date}/`}>返回網頁版</a>
    </p>
    <p style="margin:0;color:var(--sea-deep);font-weight:700;letter-spacing:0.08em;">日日學 · 宜蘭每日見聞</p>
    <h1 style="font-family:var(--font-display);font-size:1.9rem;margin:0.35rem 0 0.2rem;">{data.title}</h1>
    <p class="meta" style="margin-top:0;">{formatZhDate(data.date)} · {chars} 字 · 公益學習、可供張貼</p>
    <figure class="article-image">
      <img src={`${base}${data.image}`} alt={data.image_alt} width="1800" height="1160" />
    </figure>
    <p class="credit">{data.image_credit} {data.image_license}（{data.image_license_url}）作者：{data.image_author}．{data.image_source_url}</p>
    <div class="yilan-body" style="font-size:1.15rem;margin-top:0.8rem;">
      <Content />
    </div>
    <section class="sources">
      <h2>資料來源</h2>
      <ul>
        {data.sources.map((s) => (
          <li>{s.title}（{s.url}）{s.note ? ` — ${s.note}` : ''}</li>
        ))}
      </ul>
    </section>
    <p class="credit" style="margin-top:1.2rem;">本頁為非營利公益學習用途。請以 A4 直式列印，建議邊距 12 mm。</p>
  </article>
</BaseLayout>
